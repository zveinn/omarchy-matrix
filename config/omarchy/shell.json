{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "sveinn.clock",
    "layout": {
      "left": [
        {
          "id": "sveinn.menu"
        },
        {
          "id": "sveinn.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "sveinn.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "sveinn.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "sveinn.tray"
        },
        {
          "id": "sveinn.agents"
        },
        {
          "id": "sveinn.bluetooth"
        },
        {
          "id": "sveinn.network"
        },
        {
          "id": "sveinn.audio"
        },
        {
          "id": "sveinn.monitor"
        },
        {
          "id": "sveinn.power",
          "showPercentage": false
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "sveinn.menu"
  ]
}
