{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "matrix.clock",
    "layout": {
      "left": [
        {
          "id": "matrix.menu"
        },
        {
          "id": "matrix.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "matrix.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "matrix.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "matrix.tray"
        },
        {
          "id": "matrix.agents"
        },
        {
          "id": "matrix.bluetooth"
        },
        {
          "id": "matrix.network"
        },
        {
          "id": "matrix.audio"
        },
        {
          "id": "matrix.monitor"
        },
        {
          "id": "matrix.power",
          "showPercentage": false
        }
      ]
    },
    "id": "matrix.bar",
    "autoHide": true,
    "autoHideDelay": 500,
    "autoHidePeek": false
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "matrix.menu"
  ]
}
